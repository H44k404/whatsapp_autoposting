# Copy this file to .env and fill in values.
# Group JIDs and the control chat JID are discovered by running:
#   npm run discover-groups
# after scanning the QR code with the bot's WhatsApp number.

# The control DM JID, or the control group JID (from `npm run discover-groups`).
CONTROL_CHAT_JID=

# Required when CONTROL_CHAT_JID is a group; only this sender may approve/reject or run commands.
# Keep blank for a private control DM. Enter the owner JID locally; do not share it.
CONTROL_OWNER_JID=

# The source group's JID, ends in @g.us
MAIN_GROUP_JID=

# PostgreSQL database and sessions
DATABASE_URL=postgresql://whatsapp_app:replace-with-a-long-random-password@localhost:5432/whatsapp_automation
# Used only by `npm run db:migrate`; never load this into the running app.
DATABASE_ADMIN_URL=postgresql://postgres:replace-with-admin-password@localhost:5432/whatsapp_automation
DATABASE_POOL_MAX=10
DATABASE_SSL=false
SESSION_SECRET=replace-with-at-least-32-random-characters
BCRYPT_COST=12
NODE_ENV=production
DASHBOARD_PORT=3001

# How long to wait (minutes) for an approval reply before auto-discarding a pending request
APPROVAL_TIMEOUT_MINUTES=30

# Delay (ms) between each group send during broadcast, to reduce spam-detection risk
BROADCAST_DELAY_MS=3000

# Video compression settings (higher CRF means smaller output and lower quality)
ENABLE_VIDEO_COMPRESSION=true
VIDEO_TARGET_WIDTH=853
VIDEO_TARGET_HEIGHT=480
VIDEO_CRF=32
VIDEO_PRESET=medium
AUDIO_BITRATE=128k

# Optional local Ollama integration for natural-language YES/NO parsing + caption summarization
USE_OLLAMA=true
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# Logging level for pino (fatal, error, warn, info, debug, trace, silent)
LOG_LEVEL=info

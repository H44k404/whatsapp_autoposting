# Copy this file to .env and fill in values.
# Group JIDs and the control chat JID are discovered by running:
#   npm run discover-groups
# after scanning the QR code with the bot's WhatsApp number.

# Your personal number in format 947XXXXXXXX@s.whatsapp.net (the "control chat" the bot DMs for approvals)
CONTROL_CHAT_JID=

# The source group's JID, ends in @g.us
MAIN_GROUP_JID=

# Dashboard authentication
DASHBOARD_USERNAME=replace-with-your-username
DASHBOARD_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-strong-secret
NODE_ENV=production
DASHBOARD_PORT=3001

# How long to wait (minutes) for an approval reply before auto-discarding a pending request
APPROVAL_TIMEOUT_MINUTES=30

# Delay (ms) between each group send during broadcast, to reduce spam-detection risk
BROADCAST_DELAY_MS=3000

# Optional local Ollama integration for natural-language YES/NO parsing + caption summarization
USE_OLLAMA=true
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# Logging level for pino (fatal, error, warn, info, debug, trace, silent)
LOG_LEVEL=info

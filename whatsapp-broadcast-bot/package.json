{
  "name": "whatsapp-broadcast-bot",
  "version": "1.0.0",
  "description": "WhatsApp media approval & broadcast automation bot using Baileys + optional Ollama NLU/captioning",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "discover-groups": "node src/discover-groups.js",
    "prod": "cross-env NODE_ENV=production node src/index.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed-admin": "node scripts/seed-admin.js",
    "db:create-worker": "node scripts/create-worker.js",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "test:auth": "node scripts/test-auth-flow.js",
    "test:admin": "node scripts/test-admin-flow.js",
    "test:isolation": "node test/workspace-isolation.js"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "baileys": "6.7.24",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^7.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.7",
    "prisma": "^6.12.0"
  },
  "engines": {
    "node": ">=18"
  }
}
